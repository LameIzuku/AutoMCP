# Account mode (no API keys; uses the paired browser extension by default).
# BHOOT_MODE=accounts
# Optional assisted fallback: BHOOT_CLAUDE_CAPTURE=C:/absolute/path/sonnet-capture.local.json
# BHOOT_CODEX_BIN=C:/absolute/path/codex.exe
# Leave BHOOT_MODE unset for the original API mode below.
# Set these in your environment or use node --env-file=<absolute-path>.
# Do not store real keys in this example. This folder is inside OneDrive.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Choose model IDs available to your API accounts. No model is silently substituted.
OPENAI_MODEL=
ANTHROPIC_MODEL=
# Optional; defaults to OPENAI_MODEL.
BHOOT_JUDGE_MODEL=
BHOOT_TIMEOUT_MS=60000
BHOOT_MAX_OUTPUT_TOKENS=2048
BHOOT_MAX_REQUESTS=30
BHOOT_MIN_CONFIDENCE=0.8
# Offline fixtures only; never enable this for actual Grok work.
BHOOT_MOCK=0
